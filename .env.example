# ==============================================================================
# PrimeHomeKanpur - Environment Variables Configuration (.env.example)
# ==============================================================================
# IMPORTANT:
# - Copy this file to .env.local for local development.
# - NEVER commit .env.local or real secrets to Git.
# - Distinguish PUBLIC client variables (prefixed NEXT_PUBLIC_) from PRIVATE secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT CONFIGURATION (Safe to expose to browser / client bundles)
# ------------------------------------------------------------------------------

# Supabase Project HTTPS API URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public API Key (or Publishable Key)
# Used by browser client for public queries & RLS-governed user operations
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Canonical Site URL (Used for SEO, canonical tags, sitemaps, auth redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary Public Cloud Name (Client-side media rendering & signed upload URL)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Razorpay Public Key ID (Client-side checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Optional unsigned upload preset if preferred:
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=primehome_preset

# ------------------------------------------------------------------------------
# 2. PRIVATE SERVER SECRETS (🔒 SERVER-ONLY — NEVER EXPOSE TO CLIENT OR NEXT_PUBLIC_)
# ------------------------------------------------------------------------------

# Supabase Service Role Secret Key (Bypasses RLS - admin actions only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudinary Private API Credentials (Used server-side for HMAC upload signing)
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Webhook & Verification Key Secret (Server-side HMAC-SHA256 signature verification)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
